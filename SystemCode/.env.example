NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
AURA_INSTANCEID=
AURA_INSTANCENAME=
# Optional, Docker only: Neo4j URI as seen from the API container, e.g. bolt://host.docker.internal:7687 for a local Neo4j.
NEO4J_DOCKER_URI=

# Optional Langfuse Cloud or self-hosted endpoint (never commit real keys).
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=nonprod
LANGFUSE_RELEASE=

# Reranker: rule (nutrient ranking, default) or jev (needs JEV_API_KEY, else the API will not start).
RANKER_MODE=rule
JEV_API_KEY=
JEV_MODEL=jev-latest
# Judge task after generate: jev (default, needs JEV_API_KEY, else the API will not start) or off.
JUDGE_MODE=jev
REMY_DATA_VERSION=unspecified

# Setting a reviewer token enables local ranking snapshots and protects grading.
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
REMY_EVALUATION_TOKEN=
REMY_EVALUATION_DB=target/evaluations.sqlite3

# Filled by: uv run --package remy-api python scripts/init_langfuse.py --path .env.nonprod
# (or set them yourself). Passwords/secrets: generate with openssl rand -hex 32.
LANGFUSE_PORT=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
REMY_POSTGRES_PASSWORD=
REMY_JWT_SECRET=
POSTGRES_PASSWORD=
